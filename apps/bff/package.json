{
  "name": "@mbst/bff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --sourcemap --outfile=dist/main.js --external:express --external:helmet --external:zod",
    "start": "SERVE_WEB_APP=true node --enable-source-maps dist/main.js",
    "preview": "tsx --env-file=../../.env src/main.ts",
    "test": "mocha",
    "check:contract": "tsx --env-file=../../.env scripts/check-contract.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/express": "5.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/supertest": "7.2.1",
    "chai": "6.2.2",
    "esbuild": "0.28.2",
    "mocha": "11.8.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@mbst/contracts": "workspace:*",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "zod": "4.6.5"
  }
}
