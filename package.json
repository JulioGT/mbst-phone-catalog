{
  "name": "mbst-phone-catalog",
  "version": "0.0.0",
  "private": true,
  "description": "Phone catalog challenge: React 19 + Express BFF, hexagonal architecture.",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:arch": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test:arch": "node --test tools/architecture/architecture.test.mjs",
    "verify": "pnpm lint && pnpm check:arch && pnpm test:arch && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "dependency-cruiser": "16.10.4",
    "turbo": "2.11.5",
    "typescript": "5.9.3"
  }
}
