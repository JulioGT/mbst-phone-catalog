# Copy to .env and fill in. Never commit .env.
# The BFF is the only process that reads these; the browser never sees them.

# Base URL of the catalog API (no trailing slash).
CATALOG_API_BASE_URL=https://prueba-tecnica-api-tienda-moviles.onrender.com

# API key sent as the `x-api-key` header. Use the key given in the challenge statement.
CATALOG_API_KEY=replace-with-the-key-from-the-challenge

# Upstream request timeout in milliseconds (the host may have slow cold starts).
CATALOG_API_TIMEOUT_MS=15000

# Port the BFF (and the web app it serves in production) listens on.
PORT=3000

# Serve the built web app (apps/web/dist) from the BFF, as in production. `pnpm start` sets it.
SERVE_WEB_APP=false

# Comma-separated list of feature flags that are ON. See docs/feature-flags.md.
FEATURE_FLAGS=similar-products

# Optional, only when the GrowthBook adapter is enabled (not required for the challenge).
# GROWTHBOOK_API_HOST=
# GROWTHBOOK_CLIENT_KEY=
